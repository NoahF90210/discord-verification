# Copy to .env locally; replace every replace_... value. Never commit real values.
# Run from the repository directory. See docs/setup.md for setup and operations.
# Non-SMTP settings: inherited environment values take precedence over this file.

# Discord application and IDs from the authorized server (Developer Mode -> Copy ID).
DISCORD_TOKEN=replace_with_bot_token
DISCORD_GUILD_ID=replace_with_server_id
VERIFICATION_CHANNEL_ID=replace_with_channel_id
VERIFIED_ROLE_ID=replace_with_role_id

# Generate once: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep stable across restarts; back it up securely with the database.
VERIFICATION_SECRET=replace_with_a_random_secret_of_at_least_32_bytes

# Persistent database path, relative to the working directory. Do not delete to reset limits.
DATABASE_PATH=data/verification.sqlite3
# Exact domains only, no @ or wildcards. The default pair shares a canonical identity.
ALLOWED_EMAIL_DOMAINS=ucsb.edu,umail.ucsb.edu

# Explicit SMTP values here override inherited shell settings. Missing entries use the environment.
# SMTP values are literal (no ${VARIABLE} expansion). Restart after changing this file.
# iCloud example, not a required provider: replace with your mailbox's SMTP settings.
# The iCloud password must be app-specific, NOT your Apple password.
# Use single quotes around passwords containing spaces or # (dotenv syntax).
# TLS only: starttls normally uses 587; ssl normally uses 465.
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=replace_with_sender_address
SMTP_PASSWORD=replace_with_app_specific_password
# One plain sender address authorized by your provider, without a display name.
SMTP_FROM=replace_with_sender_address
