# Copy to .env locally. Never commit real values.
DISCORD_TOKEN=replace_with_bot_token
DISCORD_GUILD_ID=replace_with_server_id
VERIFICATION_CHANNEL_ID=replace_with_channel_id
VERIFIED_ROLE_ID=replace_with_role_id

# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep stable across restarts; back it up securely with the database.
VERIFICATION_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
DATABASE_PATH=data/verification.sqlite3
ALLOWED_EMAIL_DOMAINS=ucsb.edu,umail.ucsb.edu

# Explicit SMTP values here override inherited shell settings. Missing entries use the environment.
# SMTP values are literal (no ${VARIABLE} expansion). Restart after changing this file.
# iCloud example. The password is an app-specific password, NOT your Apple password.
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=replace_with_sender_address
SMTP_PASSWORD=replace_with_app_specific_password
SMTP_FROM=replace_with_sender_address
